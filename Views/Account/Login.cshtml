@model LoginFormModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="account-page">
    <p class="eyebrow">Welcome back</p>
    <h1>Sign in</h1>
    <p>Use the login ID you chose when creating your account.</p>
    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-field"><label asp-for="LoginId">Login ID</label><input asp-for="LoginId"
                                                                                    autocomplete="username" /></div>
            <div class="form-field"><label asp-for="Password">Password</label><input asp-for="Password"
                                                                                         autocomplete="current-password" /></div>
                <button class="button button-dark" type="submit">Sign in</button>
            </form>
            <p>New here? <a asp-action="Register">Create an account</a></p>
        </section>