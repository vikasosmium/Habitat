@model PropertyListing
@{
    ViewData["Title"] = "List a property";
    ViewData["ExistingPhotoCount"] = 0;
}
<section class="form-page">
    <a class="back-link" asp-action="Mine">← My listings</a>
    <div class="form-heading">
        <p class="eyebrow">Share a place</p>
        <h1>List your property.</h1>
        <p>Rooms, flats, PGs, homes, shops and land all belong here.</p>
    </div>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="property-form">
        <partial name="_SimpleListingForm" model="Model" />
        <div class="form-actions"><a class="button button-outline" asp-action="Index">Cancel</a><button
            class="button button-dark" type="submit">Publish listing <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>