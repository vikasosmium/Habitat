@model IReadOnlyList<PropertyListing>
@{
    ViewData["Title"] = "My listings";
}

<section class="dashboard-page">
    <div class="dashboard-heading">
        <div>
            <p class="eyebrow">Your account</p>
            <h1>My listings</h1>
            <p>Keep your properties up to date.</p>
        </div><a class="button button-dark" asp-action="Create">Add a property <span aria-hidden="true">+</span></a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state dashboard-empty"><span class="empty-mark">⌂</span>
            <h3>Your next listing starts here.</h3>
            <p>Add a room, flat, PG, home, commercial space or land.</p><a class="button button-dark"
                                                                           asp-action="Create">Create a listing <span aria-hidden="true">→</span></a>
        </div>
    }
    else
    {
        <div class="manage-listings">
            @foreach (var listing in Model)
            {
                var coverPhoto = listing.Photos.FirstOrDefault()?.ImagePath ?? listing.ImageUrl ??
     "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=360&q=80";
                <article class="manage-row">
                    <img src="@coverPhoto" alt="" />
                    <div class="manage-description">
                        <p class="eyebrow">@listing.ListingType · @listing.PropertyType</p>
                        <h2><a asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></h2>
                        <p>@listing.Locality, @listing.City</p>
                    </div>
                    <strong class="manage-price">₹@listing.Price.ToString("N0")</strong>
                    <div class="manage-actions"><a class="button button-outline" asp-action="Edit"
                                                       asp-route-id="@listing.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@listing.Id" onsubmit="return confirm('Delete this listing?')">
                            <button class="button button-danger" type="submit">Delete</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>